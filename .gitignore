# ==============================================================================
# .gitignore - Foco no Chinelo (HTML5 / CSS3 / JavaScript)
# ==============================================================================

# Arquivos do Sistema Operacional
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Configurações de IDEs e Editores
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Diretórios e logs do Antigravity / IA
.gemini/
.agents/

# Arquivos de ambiente e segredos (chaves, tokens e credenciais)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# Logs e arquivos temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
/tmp/

# Dependências (caso sejam utilizadas ferramentas futuramente)
node_modules/
dist/
build/
